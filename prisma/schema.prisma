generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  DIGITAL_PRODUCT
  SERVICE
}

enum ProductStatus {
  PUBLISHED
  UNPUBLISHED
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  shortDescription   String
  description        String        @db.Text
  // Whole US cents: 4900 is $49.00.
  priceCents         Int
  type               ProductType
  category           String
  image              String?
  // Private storage reference. Never select this for public responses.
  digitalFile        String?
  // Short plain-text lines shown under "What's Included".
  included           String[]      @default([])
  // Services only.
  durationDays       Int?
  requirements       String?       @db.Text
  // Arabic content. Optional: a missing value falls back to the English field.
  nameAr             String?
  categoryAr         String?
  shortDescriptionAr String?
  descriptionAr      String?       @db.Text
  includedAr         String[]      @default([])
  requirementsAr     String?       @db.Text
  status             ProductStatus
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  orderItems         OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id                      String      @id @default(cuid())
  // Shown as #1001. The migration restarts the sequence at 1001.
  number                  Int         @unique @default(autoincrement())
  // Set when the customer was signed in at checkout; null for guest orders.
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // From Stripe's customer_details.email; how a guest order reaches an account.
  customerEmail           String?
  status                  OrderStatus @default(PENDING)
  // Whole cents of `currency`, from the session's amount_total.
  totalCents              Int
  currency                String
  stripeCheckoutSessionId String      @unique
  stripePaymentIntentId   String?
  items                   OrderItem[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Unit price paid, in cents, from the Stripe line item.
  priceCents Int
  quantity   Int

  @@index([orderId])
  @@index([productId])
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  // Trimmed and lowercased before every write and lookup.
  email        String    @unique
  // "scrypt$N$r$p$salt$hash", salt and hash base64url (lib/password.ts).
  passwordHash String
  role         Role      @default(CUSTOMER)
  sessions     Session[]
  orders       Order[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 hex of the cookie token; the raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
