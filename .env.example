# PostgreSQL connection string. Copy this file to .env and fill it in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public origin of the site, used for canonical URLs, the sitemap, and social
# tags. Defaults to http://localhost:3000; set it in every deployed environment.
SITE_URL="http://localhost:3000"

# Stripe secret key, server only. Use a test key (sk_test_...) locally.
STRIPE_SECRET_KEY="sk_test_..."

# Stripe webhook signing secret, server only. Locally, `stripe listen
# --forward-to localhost:3000/api/stripe/webhook` prints it; in production, copy
# it from the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Tests only, never set in production: points the Stripe SDK at the fake Stripe
# the browser tests start (`pnpm test:browser` sets it itself). Honored only
# with a test key.
# STRIPE_API_BASE="http://localhost:12111"

# Transactional email through Resend, server only. Leave both unset to turn
# email off (development); setting only one is an error. EMAIL_FROM's domain
# must be verified in Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Abody <orders@your-domain>"
# The inbox for new-order notices; no admin email is sent when it is unset.
# ADMIN_NOTIFICATION_EMAIL="team@your-domain"

# The request header that carries the visitor's IP, for the limits on
# registration, discount codes, and the analytics beacon. Leave it unset in
# development: every visitor then shares one limit. In production, set it to
# the header your host or proxy sets (for example x-real-ip, or x-forwarded-for,
# of which only the rightmost entry is used). Never pick a header that clients
# can set directly, or the limits can be bypassed.
# RATE_LIMIT_IP_HEADER="x-real-ip"

# Private object storage for digital product files, server only. Leave all of
# these unset to keep files in the local storage/ folder (development). Set the
# four required ones to use a private S3-compatible bucket; setting only some is
# an error. Copy existing local files up with `pnpm storage:upload`.
# Cloudflare R2: S3_REGION="auto" and S3_ENDPOINT is the account endpoint.
# AWS S3: S3_REGION is the bucket's region; leave S3_ENDPOINT unset.
# S3_BUCKET="abody-files"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
